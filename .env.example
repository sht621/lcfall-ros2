# Copy to .env before the authorized Pi stage. Do not store GitHub tokens here.
# All source locks must be full lowercase 40-character commits, selected for Jazzy ARM64.
# Source-confirmed release candidates; NOT Pi build/hardware validated.
# SDK v2.56.4 + ROS wrapper 4.56.4; Livox SDK v1.3.1 + driver 1.2.6.
# See docs/pi_environment_preparation.md for evidence and unresolved dependencies.
LIBREALSENSE_COMMIT=5af97a58423ec11822e8d951d37d9c6945a09a24
REALSENSE_ROS_COMMIT=bafc21080c5c8e259dadbb309797949aee0dd950
LIVOX_SDK2_COMMIT=f5d9375f84efe2b15bc0a052d3e18482ed13adf4
LIVOX_DRIVER_COMMIT=13eb05e4e6dd7a765b934d0c5fd6236676a57b49
# HailoRT 4.23.0 deb + cp312 ARM64 wheel are downloaded during both image builds.
# Version/official HTTPS URLs are fixed in build-tools.sh; no artifact paths needed.
# HEF v2.18.0 is downloaded at build time; models/pose_model.yaml is image-bundled.
# Manifest/decoder statically matched to Pi HEF metadata; inference NOT RUN here.
BUILD_JOBS=1
HAILO_DEVICE=/dev/hailo0
REALSENSE_USB_DEVICE=
HAILO_GID=
USB_GID=
ROS_DOMAIN_ID=0
ENABLE_BRIDGE=true
PUBLISH_MOUNT_TF=true
FRAME_SERVICE_NAME=/send_synchronized_frame

# EdgeRM only. The ZIP mentions i047840/2026011600; it is not assumed latest.
# Set a reviewed ref and its exact commit (or use the same full commit for both).
EDGERM_ROS2_REF=
EDGERM_ROS2_COMMIT=
# Required only when the selected EdgeRM fork lacks these source packages.
IMAGE_COMMON_COMMIT=
VISION_OPENCV_COMMIT=
DIAGNOSTICS_COMMIT=
PERCEPTION_PCL_COMMIT=
PCL_MSGS_COMMIT=
EDGERM_URL=http://localhost:8332/api/v0.5
# Match the receiving server; reserve this runtime for SendSynchronizedFrame.
EDGERM_RUNTIME_NAME=fall_detection_frame_runtime
EDGERM_VERBOSE=false
