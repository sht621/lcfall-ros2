# Pi only. Exact known-compatible commits/tags and ABI artifacts must be selected.
# Current transport: use an EdgeRM-patched Jazzy ARM64 base and WITH_EDGERM=ON.
# Stock values below describe the ordinary ROS build, not functioning EdgeRM.
EDGE_ROS_BASE_IMAGE=ros:jazzy-ros-base
WITH_EDGERM=OFF
LIBREALSENSE_REF=
REALSENSE_ROS_REF=
LIVOX_SDK2_REF=
LIVOX_DRIVER_REF=
HAILORT_DEB=
HAILORT_WHEEL=
HAILO_DEVICE=/dev/hailo0
REALSENSE_USB_DEVICE=
HAILO_GID=
USB_GID=
ROS_DOMAIN_ID=0
ENABLE_BRIDGE=true
PUBLISH_MOUNT_TF=true
BUILD_JOBS=2
