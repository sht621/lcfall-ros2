<?xml version="1.0"?>
<package format="3">
  <name>fall_detection_edge</name>
  <version>0.1.0</version>
  <description>Pi 5 Hailo RGB and LiDAR edge observation pipeline.</description>
  <maintainer email="maintainers@example.com">Edge pipeline maintainers</maintainer>
  <license>Apache-2.0</license>
  <buildtool_depend>ament_python</buildtool_depend>
  <depend>rclpy</depend>
  <depend>rcl_interfaces</depend>
  <depend>fall_detection_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
